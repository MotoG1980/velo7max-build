# Seed config for LTC Velo7 Max (ltc_vl7m19k), mediatek/filogic (MT7988A)
# Expand with: cp velo7max.config .config && make defconfig
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_ltc_vl7m19k=y

# initramfs image for a RAM-only test boot before flashing
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# Web UI (snapshots don't include it by default)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# Bootloader environment tools (fw_printenv / fw_setenv)
CONFIG_PACKAGE_uboot-envtools=y
